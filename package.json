{
  "name": "reachinbox-email-scheduler",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @reachinbox/backend\" \"npm run dev -w @reachinbox/frontend\"",
    "worker": "npm run worker -w @reachinbox/backend",
    "build": "npm run build -ws",
    "lint": "npm run lint -ws",
    "test": "npm run test -ws",
    "prisma:generate": "npm run prisma:generate -w @reachinbox/backend",
    "prisma:migrate": "npm run prisma:migrate -w @reachinbox/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
